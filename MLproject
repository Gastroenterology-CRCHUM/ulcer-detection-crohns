name: ulcer_detection

python_env: python_env.yaml

entry_points:

  # ── Main training (single model) ─────────────────────────────────
  train:
    parameters:
      mode:             {type: str,   default: "cv"}
      n_splits:         {type: int,   default: 5}
      register:         {type: str,   default: "false"}
    command: >
      python -m scripts.ulcer.train
        --mode {mode}
        --n-splits {n_splits}
        $([ "{register}" = "true" ] && echo "--register")

  # ── Batch experiments (all 9 paper configurations) ────────────────
  run_experiments:
    parameters:
      plan:     {type: str, default: "configs/experiments/ulcer_batch.yaml"}
      heldout:  {type: str, default: "data/ulcer/heldout/heldout_temporal_manifest.csv"}
    command: >
      python scripts/run_experiments.py
        --plan {plan}
        --heldout-manifest {heldout}

  # ── CV validation-fold report ─────────────────────────────────────
  cv_results:
    parameters:
      output_dir:         {type: str, default: "results/ulcer/cv"}
      heldout_output_dir: {type: str, default: "results/ulcer/heldout"}
    command: >
      python -m scripts.ulcer.cv_results
        --output-dir {output_dir}
        --heldout-output-dir {heldout_output_dir}

  # ── Held-out ensemble evaluation + effect decomposition ───────────
  effect_decomposition:
    parameters:
      manifest:   {type: str, default: "data/ulcer/heldout/heldout_temporal_manifest.csv"}
      output_dir: {type: str, default: "results/ulcer/heldout"}
    command: >
      python -m scripts.ulcer.effect_decomposition
        --manifest {manifest}
        --output-dir {output_dir}

  # ── Preprocessing ─────────────────────────────────────────────────
  preprocess:
    parameters:
      skip_preprocess: {type: str, default: "false"}
    command: >
      python -m scripts.ulcer.preprocess
        $([ "{skip_preprocess}" = "true" ] && echo "--skip-preprocess")
